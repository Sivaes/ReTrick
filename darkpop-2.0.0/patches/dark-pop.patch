+        d.last_freeze_held.store(d.freeze_held.load(std::memory_order_relaxed), std::memory_order_relaxed);
+        d.last_freeze_lost.store(d.freeze_lost.load(std::memory_order_relaxed), std::memory_order_relaxed);
