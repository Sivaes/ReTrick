+        const auto board = d.parts[0].load(std::memory_order_relaxed);
+        for (int i = 0; i < 6; ++i) {
+            float value{};
+            row.board_vel[i] = board && read(board + body_velocity_offset + 4 * (i + i / 3), value) && std::isfinite(value) ? value : 9.0f;
+        }
+    }
+    {
