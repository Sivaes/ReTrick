+            d.rest_ticks.fetch_add(1, std::memory_order_relaxed);
+        else
+            d.rest_ticks.store(0, std::memory_order_relaxed);
+    } else {
+        d.rest_ticks.store(0, std::memory_order_relaxed);
+    }
